# --- Base de données (injectées automatiquement par l'intégration « Upstash for Redis » de Vercel)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (ou UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)

# --- OBLIGATOIRE : chaîne aléatoire d'au moins 32 caractères (openssl rand -hex 32)
SESSION_SECRET=

# --- OBLIGATOIRE : identifiant(s) administrateur, séparés par des virgules (minuscules)
ADMIN_USERNAMES=coordination.cap

# --- OBLIGATOIRE au premier accès : mot de passe initial de l'administrateur
# (8 caractères minimum, lettre + chiffre). Sert uniquement à créer le compte lors de la
# première connexion dans l'onglet « Coordination » ; ensuite, changez-le dans « Mon compte ».
ADMIN_PASSWORD=

# --- Facultatif : "false" = les comptes pharmaciens sont actifs sans validation.
# Par défaut, chaque nouveau compte doit être activé par la coordination (recommandé).
REQUIRE_APPROVAL=true
